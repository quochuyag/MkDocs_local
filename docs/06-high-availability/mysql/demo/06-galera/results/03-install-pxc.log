--- zz-pxc.cnf ---
[mysqld]
wsrep_provider                = /usr/lib/galera4/libgalera_smm.so
wsrep_cluster_address         = gcomm://192.168.10.11,192.168.10.12,192.168.10.13
wsrep_cluster_name            = pxc-cluster
wsrep_node_name               = pxc-node1
wsrep_node_address            = 192.168.10.11

binlog_format                 = ROW
default_storage_engine        = InnoDB
innodb_autoinc_lock_mode      = 2

wsrep_sst_method              = xtrabackup-v2
# wsrep_sst_auth removed in PXC 8.0 — SST now uses internal mysql.pxc.sst.user.<rand>
# auto-created by mysqld upon donor selection (no manual user needed).

# Tắt SSL cluster cho LAB (PXC 8.0 mặc định ON → mỗi node sinh cert riêng, handshake fail).
# Production: bật lại + đồng bộ ca.pem/server-cert.pem/server-key.pem giữa các nodes.
pxc-encrypt-cluster-traffic    = OFF

pxc_strict_mode               = ENFORCING
